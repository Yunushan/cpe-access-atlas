{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cpe-access-atlas/recipe.schema.json",
  "title": "CPE Access Atlas recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "country", "status", "confidence", "isp",
    "device", "firmware", "access", "capabilities", "blockers", "evidence",
    "next_evidence", "last_reviewed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "country": {"const": "TR"},
    "status": {"enum": ["researching", "experimental", "verified", "stable", "blocked"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "isp": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["vendor", "model", "aliases", "hardware_revision", "hardware_revision_status"],
      "properties": {
        "vendor": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "hardware_revision": {"type": "string", "minLength": 1},
        "hardware_revision_status": {"enum": ["unresolved", "exact"]}
      }
    },
    "firmware": {
      "type": "object", "additionalProperties": false, "required": ["display", "match_policy"],
      "properties": {"display": {"type": "string", "minLength": 1}, "match_policy": {"const": "exact"}}
    },
    "access": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "url"],
        "properties": {"title": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri"}}
      }
    },
    "next_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}

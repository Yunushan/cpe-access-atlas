include AGENTS.md CHANGELOG.md CODE_OF_CONDUCT.md CONTRIBUTING.md LEGAL.md LICENSE README*.md SECURITY.md SUPPORT.md
include requirements-build.lock requirements-ci.lock requirements-release.lock requirements-runtime.lock requirements-security.lock
include .pre-commit-config.yaml .gitignore .gitleaks.toml .gitattributes
include .clinerules .cursor/rules/cpe-atlas.mdc
include .github/CODEOWNERS .github/dependabot.yml .github/pull_request_template.md .github/ISSUE_TEMPLATE/config.yml
recursive-include .github *.yml *.awk *.json *.md
recursive-include docs *.md *.json *.txt
recursive-include scripts *.py *.sh *.ps1
recursive-include tests *.py
recursive-include schemas *.json
recursive-include src/cpe_access_atlas/data *.json

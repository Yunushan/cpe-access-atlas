{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cpe-access-atlas/providers.schema.json",
  "title": "CPE Access Atlas provider catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "country", "providers"],
  "properties": {
    "schema_version": {"const": 1},
    "country": {"const": "TR"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "aliases", "country", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "aliases": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "country": {"const": "TR"},
          "status": {"enum": ["cataloged", "researching"]}
        }
      }
    }
  }
}
